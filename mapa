<div id="map" style="width: 100%; height: 500px; border-radius: 8px; overflow: hidden;"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script>
  const map = L.map('map').setView([19.04, -98.28], 9);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
  
  const data = [
    {n:"Puebla",lt:19.043733,lg:-98.198024,p:7,c:7330},
    {n:"S. Andrés Cholula",lt:19.059957,lg:-98.294915,p:7,c:4330},
    {n:"Tepeaca",lt:18.965955,lg:-97.899376,p:4,c:2064},
    {n:"Tlatlauquitepec",lt:19.816011,lg:-97.497947,p:2,c:857},
    {n:"S. Pedro Cholula",lt:19.071505,lg:-98.315674,p:2,c:1105},
    {n:"Teziutlán",lt:19.816011,lg:-97.357058,p:2,c:750},
    {n:"Izúcar",lt:18.602095,lg:-98.465701,p:1,c:551},
    {n:"Apizaco",lt:19.415881,lg:-98.139318,p:1,c:396},
    {n:"Dist. Tepeaca",lt:19.313924,lg:-98.240440,p:1,c:600}
  ];
  
  data.forEach(loc => {
    L.circleMarker([loc.lt,loc.lg],{
      radius:loc.p>5?20:loc.p>2?15:10,
      fillColor:loc.p>5?'#f39c12':loc.p>2?'#e74c3c':'#3498db',
      color:'white',weight:3,fillOpacity:0.85
    }).bindPopup(`<b>${loc.n}</b><br>Proyectos: ${loc.p}<br>Cuestionarios: ${loc.c.toLocaleString()}`).addTo(map);
  });
</script>
